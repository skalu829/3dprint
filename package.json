{
  "name": "3dprint",
  "version": "0.1.0",
  "private": true,
  "description": "3DPrint · 3D 打印模型分享平台（Vue 3 前端）",
  "scripts": {
    "serve": "vue-cli-service serve",
    "build": "vue-cli-service build",
    "lint": "vue-cli-service lint",
    "server": "npm --prefix server run dev",
    "server:start": "npm --prefix server start",
    "install:all": "npm install && npm --prefix server install",
    "start": "npm --prefix server start"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "core-js": "^3.8.3",
    "three": "0.160.1",
    "vue": "^3.2.13",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {}
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ]
}
